# EXEMPLO RECONSTRUIDO — NAO E COPIA VERIFICADA DA VM EM PRODUCAO.
# Consulte systemd/README.md antes de utilizar.
[Unit]
Description=POI - inicializacao do cluster Minikube
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
Environment=KUBECONFIG=/home/ubuntu/.kube/config
ExecStart=/usr/local/bin/minikube start --driver=docker --cpus=3 --memory=6144 --disk-size=12g --container-runtime=containerd
ExecStartPost=/usr/local/bin/kubectl wait --for=condition=Ready node/minikube --timeout=180s
RemainAfterExit=yes
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
