[Unit]
Description=POI Atividade 5.1 - Inicializacao do Minikube
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
Environment=KUBECONFIG=/home/ubuntu/.kube/config
ExecStart=/usr/local/bin/minikube start --driver=docker --cpus=3 --memory=6144 --disk-size=12g --container-runtime=containerd
ExecStartPost=/usr/local/bin/kubectl wait --for=condition=Ready node/minikube --timeout=180s
RemainAfterExit=yes
TimeoutStartSec=600
Restart=on-failure
RestartSec=20

[Install]
WantedBy=multi-user.target
