[Unit]
Description=POI Kubernetes - Port Forward memory
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=ubuntu
Environment=HOME=/home/ubuntu
Environment=KUBECONFIG=/home/ubuntu/.kube/config
ExecStart=/usr/local/bin/kubectl -n poi-atividade5 port-forward --address 10.5.10.123 service/poi-memory 8002:8002
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
